generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  ACTIVE
  BLOCKED
}

enum NewsSource {
  MANUAL
  VK_IMPORT
}

enum LogAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  PASSWORD_CHANGE
}

model Admin {
  id           String      @id @default(cuid())
  login        String      @unique
  passwordHash String
  displayName  String?
  status       AdminStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  logs         AdminLog[]
}

model AdminLog {
  id         String    @id @default(cuid())
  adminId    String
  action     LogAction
  entityType String
  entityId   String?
  metaJson   String?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  seoTitle       String?
  seoDescription String?
  blocksJson     String
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Direction {
  id            String   @id @default(cuid())
  title         String
  description   String
  room          String?
  coverImageUrl String?
  sortOrder     Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
}

model Album {
  id            String   @id @default(cuid())
  title         String
  description   String?
  coverImageUrl String?
  sortOrder     Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  photos        Photo[]

  @@index([sortOrder])
}

model Photo {
  id        String   @id @default(cuid())
  albumId   String
  imageUrl  String
  altText   String?
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, sortOrder])
}

model News {
  id           String     @id @default(cuid())
  title        String
  text         String
  publishedAt  DateTime
  coverImageUrl String?
  source       NewsSource @default(MANUAL)
  sourceUrl    String?
  externalId   String?
  isPublished  Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([publishedAt])
  @@unique([source, externalId])
}

model ContactRequest {
  id              String   @id @default(cuid())
  name            String
  contact         String
  message         String
  consentAccepted Boolean
  createdAt       DateTime @default(now())
  ip              String?
  userAgent       String?

  @@index([createdAt])
}

model SiteSettings {
  id               String   @id @default("main")
  siteName         String   @default("Арт-центр Чудо")
  recipientEmail   String   @default("yustriada@yandex.ru")
  phone            String?
  email            String?
  address          String?
  vkUrl            String?
  yandexProfileUrl String?
  legalInn         String?
  legalOgrn        String?
  legalName        String?
  legalAddress     String?
  legalPhone       String?
  legalEmail       String?
  consentLabel     String   @default("Я даю согласие на обработку персональных данных")
  consentText      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
